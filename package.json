{
  "name": "drizzle-pg-extras",
  "version": "0.0.0",
  "private": true,
  "description": "Declare Postgres functions, triggers, extensions, partitioned tables, comments, and TimescaleDB hypertables next to a Drizzle schema and generate SQL migrations.",
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "scripts": {
    "build": "pnpm --filter @systemfsoftware/drizzle-pg-extras run build",
    "typecheck": "pnpm --filter @systemfsoftware/drizzle-pg-extras run typecheck",
    "lint": "pnpm --filter @systemfsoftware/drizzle-pg-extras run lint",
    "test": "pnpm --filter @systemfsoftware/drizzle-pg-extras run test",
    "format": "dprint fmt",
    "format:check": "dprint check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "dprint": "^0.65.0"
  }
}
