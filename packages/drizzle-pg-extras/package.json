{
  "name": "@systemfsoftware/drizzle-pg-extras",
  "version": "0.7.0",
  "description": "Declare Postgres functions, triggers, extensions, partitioned tables, comments, and TimescaleDB hypertables next to a Drizzle schema and generate SQL migrations.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/drizzle-pg-extras.git",
    "directory": "packages/drizzle-pg-extras"
  },
  "bugs": {
    "url": "https://github.com/systemfsoftware/drizzle-pg-extras/issues"
  },
  "homepage": "https://github.com/systemfsoftware/drizzle-pg-extras/tree/main/packages/drizzle-pg-extras#readme",
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "postgres",
    "postgresql",
    "migrations",
    "triggers",
    "functions",
    "partitions",
    "partitioning",
    "timescaledb",
    "hypertable"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "drizzle-pg-extras": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --type-aware --format=${f:-default}",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "drizzle-kit": ">=1.0.0-rc.6",
    "drizzle-orm": ">=1.0.0-rc.6"
  },
  "peerDependenciesMeta": {
    "drizzle-kit": {
      "optional": true
    }
  },
  "dependencies": {
    "jiti": "^2.6.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@effect/platform-node": "^4.1.5",
    "@systemfsoftware/effect-gherkin-spec": "^8.3.2",
    "@systemfsoftware/effect-microsandbox": "^6.1.0",
    "@systemfsoftware/effect-readiness": "^1.1.4",
    "@systemfsoftware/oxlint-config-recommended": "^8.0.3",
    "@systemfsoftware/vitest": "^4.1.3",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "1.0.0-rc.6",
    "drizzle-orm": "1.0.0-rc.6",
    "effect": "^4.1.5",
    "pg": "^8.16.3",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
