{
  "name": "@systemfsoftware/drizzle-pg-extras",
  "version": "0.7.1",
  "description": "Declare Postgres functions, triggers, extensions, partitioned tables, comments, and TimescaleDB hypertables next to a Drizzle schema and generate SQL migrations.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/drizzle-pg-extras.git",
    "directory": "packages/drizzle-pg-extras"
  },
  "bugs": {
    "url": "https://github.com/systemfsoftware/drizzle-pg-extras/issues"
  },
  "homepage": "https://github.com/systemfsoftware/drizzle-pg-extras/tree/main/packages/drizzle-pg-extras#readme",
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "postgres",
    "postgresql",
    "migrations",
    "triggers",
    "functions",
    "partitions",
    "partitioning",
    "timescaledb",
    "hypertable"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "drizzle-pg-extras": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; effect-tsgo oxlint . --type-aware --format=${f:-default}",
    "test": "vitest run",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "drizzle-kit": ">=0.31.0 || >=1.0.0-0",
    "drizzle-orm": ">=0.36.4 || >=1.0.0-0"
  },
  "peerDependenciesMeta": {
    "drizzle-kit": {
      "optional": true
    }
  },
  "dependencies": {
    "jiti": "^2.6.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@effect/tsgo": "^0.70.0",
    "@systemfsoftware/oxlint-config-recommended": "^8.0.3",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "effect": "^4.1.4",
    "oxlint": "~1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "pg": "^8.16.3",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
